rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 각 사용자는 자신의 팔로우(팀/선수) 문서만 읽고 쓸 수 있다.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 승부예측 투표: 로그인(게스트 포함)한 사용자는 모두 읽을 수 있고,
    // 자기 uid로만 만들거나 바꿀 수 있다. 문서 id는 "{gameId}_{uid}".
    // createdAt은 서버 시각만 받는다. 랭킹(서버 채점)은 이 시각이 경기 시작
    // 1시간 전보다 늦은 투표를 채점하지 않으므로, 결과를 보고 쓴 투표가 걸러진다.
    // 투표 목록은 읽지 못한다(내 투표 하나만). 비율은 서버가 센
    // predictionTallies를 읽는다. 목록을 열어 두면 투표 수 × 화면 수만큼 읽혀
    // 비용이 커지고, 스크립트로 통째로 긁어 갈 수도 있다.
    match /predictionVotes/{voteId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['gameId', 'uid', 'displayName', 'pick', 'gameDate', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.gameId + '_' + request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.gameId.size() <= 40
        && request.resource.data.pick in ['home', 'away']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 경기별 투표 수. 서버(tallyPredictionVote)만 쓴다.
    match /predictionTallies/{gameId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 승부예측 랭킹. 서버(updatePredictionLeaderboard)만 쓰고 앱은 읽기만 한다.
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 승부예측 토론 댓글: 로그인한 사용자는 읽기/작성, 본인 것만 삭제.
    match /predictionComments/{commentId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 500;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['gameId', 'uid', 'displayName', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.gameId.size() <= 40
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;
      // 탈퇴할 때 글쓴이 표시만 지우는 것(비식별)만 허용한다.
      allow update: if request.auth != null && anonymizingOwn();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 커뮤니티 게시글: 로그인한 사용자는 모두 읽고 쓸 수 있다. 앱에 글 수정은
    // 없다. 다른 사람이 바꿀 수 있는 건 좋아요(내 uid 하나 넣기/빼기)와
    // 댓글 수(1씩)뿐이다. 새 글은 좋아요·댓글 0개, 서버 시각으로만 만든다.
    match /communityPosts/{postId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'category', 'league', 'title', 'body', 'commentCount', 'likedBy', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.displayName)
        && request.resource.data.category in ['free', 'team', 'prediction', 'question']
        && request.resource.data.get('league', 'kbl') in ['kbl', 'nba']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && request.resource.data.commentCount == 0
        && request.resource.data.likedBy == []
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && (togglingMyLike() || stepCommentCount() || anonymizingOwn());
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    /// 좋아요: likedBy에서 내 uid 하나만 넣거나 뺀다.
    function togglingMyLike() {
      let before = resource.data.likedBy.toSet();
      let after = request.resource.data.likedBy.toSet();
      let me = [request.auth.uid].toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy.size() == after.size()
        && ((after.difference(before) == me && before.difference(after).size() == 0)
          || (before.difference(after) == me && after.difference(before).size() == 0));
    }

    /// 댓글을 달거나 지울 때 댓글 수를 1만큼 바꾼다.
    function stepCommentCount() {
      let delta = request.resource.data.commentCount - resource.data.commentCount;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
        && (delta == 1 || (delta == -1 && request.resource.data.commentCount >= 0));
    }

    /// 글쓴이 표시 이름. 닉네임(10자)이나 가린 이름이 들어온다.
    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 30;
    }

    // 신고: 로그인한 사용자가 자기 이름으로 접수만 할 수 있다.
    // 다른 사람 신고 내역을 볼 수 없도록 읽기는 막고(운영자는 콘솔에서 확인),
    // 같은 대상을 여러 번 신고해도 문서 id가 같아 한 건으로만 남는다.
    match /reports/{reportId} {
      allow read: if false;
      allow create, update: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && reportId == request.resource.data.targetId + '_' + request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 200;
      allow delete: if false;
    }

    // 뉴스 캐시와 검색어 설정은 서버(Cloud Functions)만 쓰고 읽는다.
    // 앱은 getBasketballNews 함수를 통해서만 뉴스를 받으므로 클라이언트
    // 직접 접근은 막는다. (Admin SDK는 규칙을 우회한다)
    match /newsCache/{docId} {
      allow read, write: if false;
    }
    match /newsImageCache/{docId} {
      allow read, write: if false;
    }
    match /config/{docId} {
      allow read, write: if false;
    }

    // 강제 업데이트 기준(minBuild 등). 로그인 전에 읽으므로 누구나 읽고,
    // 운영자만 콘솔에서 고친다.
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 잠금화면 실시간 스코어 구독. 문서 id는 기기의 FCM 토큰이다.
    // 토큰은 남에게 보이면 안 되므로 읽기는 막고(서버만 읽는다), 로그인한
    // 기기가 자기 토큰 문서의 팔로우 팀·Live Activity 토큰만 쓸 수 있다.
    // startedActivities(서버가 기록)는 앱이 바꾸지 못한다.
    match /liveSubscribers/{token} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['platform', 'fcmToken', 'teamKeys', 'pushToStartToken', 'activityTokens', 'updatedAt'])
        && validLiveSubscriber(token);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['platform', 'fcmToken', 'teamKeys', 'pushToStartToken', 'activityTokens', 'updatedAt'])
        && validLiveSubscriber(token);
      allow delete: if request.auth != null;
    }

    function validLiveSubscriber(token) {
      return request.resource.data.fcmToken == token
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.teamKeys is list
        && request.resource.data.teamKeys.size() <= 60
        && (!('activityTokens' in request.resource.data) || request.resource.data.activityTokens is map)
        && (!('activityTokens' in request.resource.data) || request.resource.data.activityTokens.size() <= 20);
    }

    // 진행 중인 경기의 선수 기록. 서버만 쓰고 앱은 읽기만 한다.
    match /liveBoxScores/{gameKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 진행 중인 경기의 지금 점수·쿼터·남은 시간. 서버(pushLiveScores)만 쓰고,
    // 앱은 읽기만 한다. 정적 JSON은 20분에 한 번 올라와서, 경기 중 화면은
    // 이 문서를 구독해 30초마다 갱신한다.
    match /liveGames/{gameKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 커뮤니티 댓글: 로그인한 사용자는 읽기/작성, 본인 것만 삭제.
    match /communityComments/{commentId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 500;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'displayName', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      // 탈퇴할 때 글쓴이 표시만 지우는 것(비식별)만 허용한다.
      allow update: if request.auth != null && anonymizingOwn();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    /// 내가 쓴 글의 글쓴이 표시만 "탈퇴한 사용자"로 바꾸는 수정인지.
    /// 탈퇴해도 대화 맥락이 남도록 글은 지우지 않고 이것만 바꾼다.
    function anonymizingOwn() {
      return resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == 'deleted'
        && request.resource.data.displayName == '탈퇴한 사용자';
    }
  }
}
